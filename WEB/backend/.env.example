# Puerto donde corre el backend
PORT=3000

# Clave secreta para firmar los tokens de sesion (JWT).
# Cambia esto por una cadena larga y aleatoria antes de usar en un entorno real.
JWT_SECRET=clave_secreta_dev_cambiar

# ===========================
# Conexion a MySQL (XAMPP)
# ===========================
# Valores por defecto de una instalacion tipica de XAMPP en Windows:
# - Host: localhost
# - Puerto: 3306
# - Usuario: root
# - Contrasena: (vacia, a menos que le hayas puesto una en phpMyAdmin)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=resumen_pdf_db
